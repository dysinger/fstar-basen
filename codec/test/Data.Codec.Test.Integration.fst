(**
Data.Codec.Test.Integration — Coverage anchors for all codec symbols.

Each [let _x = f] binding mechanically enforces that [f] exists and has
the expected type.  Delete a function → F* fails with "identifier not found."

This module uses [--admit_smt_queries true] because the bindings are
symbol-anchor references, not proof-bearing.  No verification conditions
are generated by a bare [let _ = f] binding.  Real tests live in
[Data.Codec.Test.Roundtrip] which has zero admits.

@header Data.Codec.Test.Integration
*)

module Data.Codec.Test.Integration

open Data.Codec
open Data.Codec.Types
open Data.Codec.Low

open FStar.Seq
open FStar.UInt8
open FStar.UInt32

(* ── Why --admit_smt_queries true ──
   This module is a coverage anchor file.  Each [let _x = f] binding
   mechanically enforces that [f] exists and has the expected type.
   If [f] is deleted or renamed, F* fails.

   None of these bindings call the functions — they only reference them.
   No verification conditions are generated by a bare [let _ = f] binding,
   so --admit_smt_queries true is semantically neutral.  It suppresses SMT
   overhead from the transitive dependency graph.

   Real tests live in [Data.Codec.Test.Roundtrip], which has zero admits.
*)
#push-options "--admit_smt_queries true"

